# ====================================================================
# Pragya Civic Platform - Environment Variables Template
# ====================================================================

# 1. Supabase Cloud Configuration (Free Tier: 50,000 MAUs, 500MB DB)
# Obtain from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key-here

# 2. Google Gemini 2.0 Flash API Key (Free Tier: 15 RPM / 1,500 RPD)
# Obtain free from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=AIzaSy...

# Note: If these keys are not set, Pragya runs smoothly in offline demo mode
# with built-in realistic Nagpur municipal data, Web Speech recognition,
# and high-accuracy local multilingual AI heuristics!

